  local phase="$1"
  local percent="$2"
  local bar_width=36
  local filled=$(( percent * bar_width / 100 ))
  local empty=$(( bar_width - filled ))
  local bar=""
  local i

  for (( i=0; i<filled; i++ )); do bar+="█"; done
  for (( i=0; i<empty; i++ )); do bar+="░"; done

  clear
  echo -e "${C_BRIGHT_CYAN}"
  cat << EOF
  ╔══════════════════════════════════════════════════════════════╗
  ║                                                              ║
  ║    ███╗   ███╗██╗██╗     ██╗███████╗                        ║
  ║    ████╗ ████║██║██║     ██║╚══███╔╝                        ║
  ║    ██╔████╔██║██║██║     ██║  ███╔╝                         ║
  ║    ██║╚██╔╝██║██║██║     ██║ ███╔╝                          ║
  ║    ██║ ╚═╝ ██║██║███████╗██║███████╗                        ║
  ║    ╚═╝     ╚═╝╚═╝╚══════╝╚═╝╚══════╝  ISO Builder v1.0.0   ║
  ║                                                              ║
  ╠══════════════════════════════════════════════════════════════╣
  ║                                                              ║
EOF
  echo -e "${C_BRIGHT_YELLOW}"
  cat << 'EOF'
  ║        )  )  )                                               ║
  ║       (  (  (    ~  ~  ~                                     ║
  ║        )  )  )                                               ║
  ║      ___________                                             ║
  ║     |           |                                            ║
  ║     |  ~~~ ~~~  | )                                          ║
  ║     |   ~~~~~~  |/                                           ║
  ║      \         /                                             ║
  ║       '-------'                                              ║
  ║                                                              ║
  ║   Grab a coffee — this won't take forever!                   ║
  ║                                                              ║
EOF
  echo -e "${C_BRIGHT_CYAN}"
  echo -e "  ║  ${C_BRIGHT_WHITE}[${bar}]${C_BRIGHT_CYAN} ${percent}%${C_RESET}                                           ${C_BRIGHT_CYAN}║"
  echo -e "${C_BRIGHT_CYAN}  ║  ${C_DIM}${phase}${C_BRIGHT_CYAN}$(printf '%*s' $(( 57 - ${#phase} )) '')║"
  cat << 'EOF'
  ║                                                              ║
  ╚══════════════════════════════════════════════════════════════╝
EOF
  echo -e "${C_RESET}"
}

print_success() {
  local iso_path="$1"
  local iso_size
  iso_size=$(du -sh "${iso_path}" 2>/dev/null | cut -f1 || echo "?")

  clear
  echo -e "${C_BRIGHT_GREEN}"
  cat << EOF
  ╔══════════════════════════════════════════════════════════════╗
  ║                                                              ║
  ║    ✓  BUILD CONCLUÍDO COM SUCESSO!                           ║
  ║                                                              ║
  ║    ISO gerada com compressão zstd nível 22                   ║
  ║    A menor ISO que você vai ver na vida. ☕                  ║
  ║                                                              ║
  ╠══════════════════════════════════════════════════════════════╣
  ║                                                              ║
EOF
  echo -e "  ║  ${C_BRIGHT_WHITE}Arquivo : ${C_BRIGHT_CYAN}${iso_path}${C_BRIGHT_GREEN}"
  echo -e "  ║  ${C_BRIGHT_WHITE}Tamanho : ${C_BRIGHT_CYAN}${iso_size}${C_BRIGHT_GREEN}"
  cat << 'EOF'
  ║                                                              ║
  ╚══════════════════════════════════════════════════════════════╝
EOF
  echo -e "${C_RESET}"
}

print_error() {
  echo -e "${C_RED}${C_BOLD}"
  cat << 'EOF'
  ╔══════════════════════════════════════════════════════════════╗
  ║   ✗  ERRO DURANTE O BUILD                                   ║
  ╚══════════════════════════════════════════════════════════════╝
EOF
  echo -e "${C_RESET}${C_RED}  $* ${C_RESET}"
  echo ""
}

# ─── Helpers ─────────────────────────────────────────────────────────────────

check_root() {
  if [[ "${EUID}" -ne 0 ]]; then
    echo -e "${C_RED}✗ Este comando requer privilégios de root.${C_RESET}"
    echo -e "  Use: ${C_BRIGHT_WHITE}sudo liz build${C_RESET}"
    exit 1
  fi
}

check_dep() {
  command -v "$1" &>/dev/null
}

# Detecta família do sistema
detect_family() {
  if command -v dnf &>/dev/null || command -v rpm &>/dev/null; then
    echo "rhel"
  elif command -v pacman &>/dev/null; then
    echo "arch"
  else
    echo "debian"
  fi
}

# Retorna o binário correto do grub-mkrescue disponível
find_grub_mkrescue() {
  if check_dep grub2-mkrescue; then
    echo "grub2-mkrescue"
  elif check_dep grub-mkrescue; then
    echo "grub-mkrescue"
  else
    echo ""
  fi
}

preflight_check() {
  local missing=()

  # mksquashfs
  if ! check_dep mksquashfs; then
    missing+=("mksquashfs  →  dnf: squashfs-tools | apt: squashfs-tools")
  fi

  # xorriso
  if ! check_dep xorriso; then
    missing+=("xorriso     →  dnf/apt: xorriso")
  fi

  # grub (nome varia por distro)
  if [[ -z "$(find_grub_mkrescue)" ]]; then
    missing+=("grub-mkrescue → dnf: grub2-tools-extra | apt: grub-common")
  else
    # Verifica se os pacotes de arquitetura do GRUB e o mtools estão instalados
    if ! check_dep mtools; then
      missing+=("mtools        → Necessário para gerar boot UEFI (apt/dnf install mtools)")
    fi
    if [[ ! -d "/usr/lib/grub/i386-pc" ]]; then
      missing+=("grub-pc-bin   → Necessário para boot BIOS (apt install grub-pc-bin)")
    fi
    if [[ ! -d "/usr/lib/grub/x86_64-efi" ]]; then
      missing+=("grub-efi-bin  → Necessário para boot UEFI (apt install grub-efi-amd64-bin)")
    fi
  fi

  # Aviso sobre zstd no mksquashfs (não bloqueia o build)
  if check_dep mksquashfs; then
    if ! mksquashfs -version 2>&1 | grep -qi "zstd" 2>/dev/null; then
      echo -e "${C_YELLOW}⚠ mksquashfs sem suporte a zstd — usando compressão gzip como fallback.${C_RESET}"
      echo -e "  Para zstd: ${C_BRIGHT_WHITE}dnf install squashfs-tools-ng${C_RESET} ou compile do fonte."
      echo ""
      COMP_ALGO="gzip"
      COMP_LEVEL=""
    fi
  fi

  if [[ ${#missing[@]} -gt 0 ]]; then
    echo -e "${C_RED}${C_BOLD}✗ Dependências faltando:${C_RESET}"
    for dep in "${missing[@]}"; do
      echo -e "  ${C_RED}• ${dep}${C_RESET}"
    done
    echo ""
    echo -e "${C_YELLOW}Execute: ${C_BRIGHT_WHITE}sudo ./install.sh${C_RESET} para instalar automaticamente."
    exit 1
  fi
}

cleanup() {
  if mountpoint -q "${WORK_DIR}/merged" 2>/dev/null; then
    umount -lf "${WORK_DIR}/merged" 2>/dev/null || true
  fi
  if mountpoint -q "${WORK_DIR}/lower" 2>/dev/null; then
    umount -lf "${WORK_DIR}/lower" 2>/dev/null || true
  fi
}

build_exclude_array() {
  # Devolve os args de exclusão como variável global EXCLUDE_ARGS (array)
  EXCLUDE_ARGS=()
  for dir in "${EXCLUDE_DIRS[@]}"; do
    [[ -e "${dir}" || "${dir}" == /* ]] && EXCLUDE_ARGS+=(-e "${dir}")
  done
  EXCLUDE_ARGS+=(-e "${WORK_DIR}" -e "${OUTPUT_DIR}")
}

# ─── Fases do build ──────────────────────────────────────────────────────────

phase_prepare() {
  print_coffee_ui "Preparando estrutura da ISO..." 5
  rm -rf "${WORK_DIR}"
  mkdir -p \
    "${WORK_DIR}/iso/live" \
    "${WORK_DIR}/iso/boot/grub" \
    "${WORK_DIR}/iso/isolinux" \
    "${WORK_DIR}/iso/install/calamares" \
    "${OUTPUT_DIR}"
}

phase_squashfs() {
  local label="Comprimindo sistema de arquivos"
  if [[ -n "${COMP_LEVEL}" ]]; then
    label="Comprimindo com ${COMP_ALGO}-${COMP_LEVEL}..."
  else
    label="Comprimindo com ${COMP_ALGO}..."
  fi
  print_coffee_ui "${label}" 15

  local sq_log="/tmp/liz-squashfs.log"
  build_exclude_array

  local lower_dir="${WORK_DIR}/lower"
  local upper_dir="${WORK_DIR}/upper"
  local work_dir="${WORK_DIR}/work"
  local merged_dir="${WORK_DIR}/merged"

  mkdir -p "${lower_dir}" "${upper_dir}" "${work_dir}" "${merged_dir}"
  mount --bind / "${lower_dir}"
  mount -t overlay overlay -o lowerdir="${lower_dir}",upperdir="${upper_dir}",workdir="${work_dir}" "${merged_dir}"

  print_coffee_ui "Removendo usuários locais da ISO..." 25
  # Remove usuários com UID >= 1000 do sistema isolado para garantir privacidade
  awk -F: '$3 < 1000 || $1 == "nobody" {print $0}' "${merged_dir}/etc/passwd" > /tmp/passwd.tmp && cat /tmp/passwd.tmp > "${merged_dir}/etc/passwd"
  awk -F: '$3 < 1000 || $1 == "nogroup" {print $0}' "${merged_dir}/etc/group" > /tmp/group.tmp && cat /tmp/group.tmp > "${merged_dir}/etc/group"
  
  # Sincroniza o shadow para conter apenas os usuários restantes no passwd
  awk -F: 'NR==FNR{a[$1];next} $1 in a' "${merged_dir}/etc/passwd" "${merged_dir}/etc/shadow" > /tmp/shadow.tmp && cat /tmp/shadow.tmp > "${merged_dir}/etc/shadow"

  # Remove as pastas originais clonadas
  rm -rf "${merged_dir}/home/"* 2>/dev/null || true
  rm -rf "${merged_dir}/root/"* 2>/dev/null || true

  print_coffee_ui "Criando usuário Live permanente..." 26
  # Evita chroot que pode falhar silenciosamente, injetando os dados direto na veia do Linux!
  echo "user:x:1000:1000:Live User,,,:/home/user:/bin/bash" >> "${merged_dir}/etc/passwd"
  echo "user::19000:0:99999:7:::" >> "${merged_dir}/etc/shadow"
  echo "user:x:1000:" >> "${merged_dir}/etc/group"
  
  # Adiciona usuário aos grupos importantes
  for g in sudo video audio plugdev netdev cdrom dip; do
    sed -i "/^${g}:/ s/\$/user/" "${merged_dir}/etc/group" 2>/dev/null || true
  done

  mkdir -p "${merged_dir}/home/user"
  cp -a "${merged_dir}/etc/skel/." "${merged_dir}/home/user/" 2>/dev/null || true
  
  # Injeta as configurações atualizadas do Calamares no ambiente Live
  local calamares_src
  calamares_src="$(dirname "$(realpath "$0")")/calamares"
  if [[ -d "${calamares_src}" ]]; then
    mkdir -p "${merged_dir}/etc/calamares"
    cp -r "${calamares_src}/." "${merged_dir}/etc/calamares/" 2>/dev/null || true
  fi

  # Cria o atalho de Instalação na Área de Trabalho
  mkdir -p "${merged_dir}/home/user/Desktop"
  
  # Remove atalhos originais de instalação do Debian (se existirem) para não confundir
  rm -f "${merged_dir}/home/user/Desktop/install-debian.desktop" "${merged_dir}/home/user/Desktop/calamares.desktop" 2>/dev/null || true
  
  cat << 'EOF' > "${merged_dir}/home/user/Desktop/install-liz.desktop"
[Desktop Entry]
Type=Application
Name=Install Liz
Comment=Instalar o sistema no disco rígido
Exec=sudo -E env LIBGL_ALWAYS_SOFTWARE=1 QT_QPA_PLATFORM=xcb calamares
Icon=system-software-install
Terminal=true
Categories=System;
EOF
  chmod +x "${merged_dir}/home/user/Desktop/install-liz.desktop"
  chown -R 1000:1000 "${merged_dir}/home/user"

  echo "user ALL=(ALL) NOPASSWD: ALL" > "${merged_dir}/etc/sudoers.d/live-user"
  chmod 440 "${merged_dir}/etc/sudoers.d/live-user"

  print_coffee_ui "Forçando Autologin na Interface Gráfica..." 27
  # GDM3 (Debian padrão)
  local gdm_conf="${merged_dir}/etc/gdm3/daemon.conf"
  if [[ -f "${gdm_conf}" ]]; then
    sed -i '/AutomaticLoginEnable/d' "${gdm_conf}"
    sed -i '/AutomaticLogin/d' "${gdm_conf}"
    sed -i '/WaylandEnable/d' "${gdm_conf}"
    if ! grep -q '\[daemon\]' "${gdm_conf}"; then
      echo "[daemon]" >> "${gdm_conf}"
    fi
    # WaylandEnable=false salva a pátria em VMs travando na interface!
    sed -i '/\[daemon\]/a WaylandEnable=false\nAutomaticLoginEnable=True\nAutomaticLogin=user' "${gdm_conf}"
  fi
  # SDDM (KDE)
  if [[ -d "${merged_dir}/usr/share/sddm" ]]; then
    mkdir -p "${merged_dir}/etc/sddm.conf.d"
    echo -e "[Autologin]\nUser=user\nRelogin=false" > "${merged_dir}/etc/sddm.conf.d/autologin.conf"
  fi
  # LightDM (XFCE/MATE)
  if [[ -d "${merged_dir}/etc/lightdm" ]]; then
    echo -e "[Seat:*]\nautologin-user=user\nautologin-user-timeout=0" >> "${merged_dir}/etc/lightdm/lightdm.conf"
  fi

  # Monta o comando de compressão usando o merged (clone limpo)
  local mksq_cmd=(mksquashfs "${merged_dir}" "${WORK_DIR}/iso/live/${SQUASH_FILE}"
    -comp "${COMP_ALGO}"
    -noappend
    "${EXCLUDE_ARGS[@]}"
  )

  # Adiciona o nível de compressão só quando o algoritmo suporta (zstd)
  if [[ -n "${COMP_LEVEL}" ]]; then
    mksq_cmd+=(-Xcompression-level "${COMP_LEVEL}")
  fi

  # Roda em background, capturando stderr para log
  "${mksq_cmd[@]}" >/dev/null 2>"${sq_log}" &
  local sq_pid=$!
  local dots=0

  local phases_msgs=(
    "${label}"
    "Aplicando compressão máxima... café quentinho! ☕"
    "Reduzindo bytes, preservando bits..."
    "Processando /usr/lib... paciência é uma virtude!"
    "Squashfs trabalhando duro pra você..."
  )

  while kill -0 "${sq_pid}" 2>/dev/null; do
    local size=0
    if [[ -f "${WORK_DIR}/iso/live/${SQUASH_FILE}" ]]; then
      size=$(stat -c%s "${WORK_DIR}/iso/live/${SQUASH_FILE}" 2>/dev/null || echo 0)
    fi
    local total_size
    total_size=$(df / --output=used -B1 2>/dev/null | tail -1 | tr -d ' ' || echo 1)
    [[ ${total_size} -le 0 ]] && total_size=1
    local pct=15
    if [[ ${size} -gt 0 ]]; then
      pct=$(( 15 + ( size * 60 / total_size ) ))
      [[ ${pct} -gt 74 ]] && pct=74
    fi
    local msg="${phases_msgs[$(( dots % ${#phases_msgs[@]} ))]}"
    print_coffee_ui "${msg}" "${pct}"
    (( dots++ )) || true
    sleep 2
  done

  if ! wait "${sq_pid}"; then
    clear
    print_error "Falha ao criar o squashfs."
    echo -e "${C_YELLOW}─── Log de erro (${sq_log}): ───${C_RESET}"
    tail -20 "${sq_log}" 2>/dev/null || true
    echo ""
    exit 1
  fi
}

phase_boot() {
  print_coffee_ui "Configurando boot BIOS + UEFI..." 77

  # ── GRUB (UEFI) ──
  local grub_cfg="${WORK_DIR}/iso/boot/grub/grub.cfg"
  cat > "${grub_cfg}" << GRUBEOF
set default=0
set timeout=5

menuentry "${ISO_LABEL} — Live" {
    linux   /live/vmlinuz boot=live components quiet splash
    initrd  /live/initrd.img
}

menuentry "${ISO_LABEL} — Install (Calamares)" {
    linux   /live/vmlinuz boot=live components quiet splash automatic-ubiquity
    initrd  /live/initrd.img
}

menuentry "Boot from hard drive" {
    chainloader (hd0,1)+1
}
GRUBEOF

  # ── ISOLINUX (BIOS) ──
  local isolinux_cfg="${WORK_DIR}/iso/isolinux/isolinux.cfg"
  cat > "${isolinux_cfg}" << ISOEOF
UI menu.c32
PROMPT 0
MENU TITLE ${ISO_LABEL} Boot Menu
TIMEOUT 50

LABEL live
  MENU LABEL ^Live — ${ISO_LABEL}
  KERNEL /live/vmlinuz
  APPEND initrd=/live/initrd.img boot=live components quiet splash

LABEL install
  MENU LABEL ^Install (Calamares)
  KERNEL /live/vmlinuz
  APPEND initrd=/live/initrd.img boot=live components quiet splash automatic-ubiquity

LABEL hd
  MENU LABEL Boot from ^Hard Drive
  LOCALBOOT 0x80
ISOEOF

  # Copia kernel e initrd do sistema atual (suporta Debian e RHEL/Rocky)
  local kernel initrd

  # Kernel: tenta vmlinuz-*, depois vmlinuz
  kernel=$(ls /boot/vmlinuz-* 2>/dev/null | sort -V | tail -1 \
    || ls /boot/vmlinuz 2>/dev/null \
    || echo "")

  # initrd: RHEL/Rocky usa initramfs-*.img; Debian usa initrd.img-*
  initrd=$(ls /boot/initramfs-*.img 2>/dev/null | grep -v 'rescue' | sort -V | tail -1 \
    || ls /boot/initrd.img-* 2>/dev/null | sort -V | tail -1 \
    || ls /boot/initrd.img 2>/dev/null \
    || echo "")

  if [[ -n "${kernel}" ]]; then
    cp "${kernel}" "${WORK_DIR}/iso/live/vmlinuz"
  fi

  if [[ -n "${initrd}" ]]; then
    cp "${initrd}" "${WORK_DIR}/iso/live/initrd.img"
  fi

  # Copia isolinux binaries (BIOS boot) — opcional
  for isolinux_dir in /usr/lib/ISOLINUX /usr/share/syslinux; do
    if [[ -f "${isolinux_dir}/isolinux.bin" ]]; then
      cp "${isolinux_dir}/isolinux.bin" "${WORK_DIR}/iso/isolinux/" 2>/dev/null || true
      break
    fi
  done
  for syslinux_dir in /usr/lib/syslinux/modules/bios /usr/share/syslinux; do
    if [[ -f "${syslinux_dir}/menu.c32" ]]; then
      cp "${syslinux_dir}"/{menu.c32,ldlinux.c32,libcom32.c32,libutil.c32} \
         "${WORK_DIR}/iso/isolinux/" 2>/dev/null || true
      break
    fi
  done
}

phase_calamares() {
  print_coffee_ui "Preparando Calamares (instalador gráfico)..." 84

  local calamares_src
  calamares_src="$(dirname "$(realpath "$0")")/calamares"

  if [[ -d "${calamares_src}" ]]; then
    cp -r "${calamares_src}/." "${WORK_DIR}/iso/install/calamares/" 2>/dev/null || true
  elif [[ -d "${CALAMARES_CONF_DIR}" ]]; then
    # Usa a configuração do sistema atual
    cp -r "${CALAMARES_CONF_DIR}/." "${WORK_DIR}/iso/install/calamares/" 2>/dev/null || true
  fi
}

phase_iso() {
  print_coffee_ui "Gerando ISO final..." 90

  local iso_file="${OUTPUT_DIR}/${ISO_NAME}-${ISO_VERSION}-${ISO_ARCH}.iso"
  local iso_log="/tmp/liz-iso.log"
  local grub_bin
  grub_bin="$(find_grub_mkrescue)"

  # Usa o grub-mkrescue para gerar uma ISO híbrida bootável (UEFI/BIOS)
  # Passamos '-- -compliance iso_9660_level=3' no final para o xorriso nativo permitir arquivos > 4GB
  "${grub_bin}" -o "${iso_file}" "${WORK_DIR}/iso" -- -volid "${ISO_LABEL}" -compliance iso_9660_level=3 >"${iso_log}" 2>&1


  local exit_code=$?

  if [[ ${exit_code} -ne 0 ]]; then
    clear
    print_error "Falha ao gerar a ISO."
    echo -e "${C_YELLOW}--- Log de erro (${iso_log}): ---${C_RESET}"
    tail -20 "${iso_log}" 2>/dev/null || true
    echo ""
    exit 1
  fi

  print_coffee_ui "Finalizando..." 98
  sleep 1

  print_success "${iso_file}"
}

# ─── Comando: build ───────────────────────────────────────────────────────────

cmd_build() {
  check_root
  preflight_check

  print_banner
  echo -e "${C_DIM}  Iniciando build da ISO ${C_BRIGHT_WHITE}${ISO_NAME}-${ISO_VERSION}-${ISO_ARCH}${C_DIM}...${C_RESET}"
  echo -e "${C_DIM}  Compressão: ${C_BRIGHT_CYAN}zstd nível ${COMP_LEVEL}${C_DIM} (máxima)${C_RESET}"
  echo -e "${C_DIM}  Saída: ${C_BRIGHT_WHITE}${OUTPUT_DIR}/${C_RESET}"
  sleep 2

  trap cleanup EXIT INT TERM

  phase_prepare
  phase_squashfs
  phase_boot
  phase_calamares
  phase_iso
}

