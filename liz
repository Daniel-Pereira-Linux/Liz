#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  liz — ISO builder
#  Gera uma ISO live bootável com Calamares usando compressão zstd nível 22
#  Uso: sudo liz build
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail

# ─── Versão ──────────────────────────────────────────────────────────────────
LIZ_VERSION="1.0.0"

# ─── Cores ───────────────────────────────────────────────────────────────────
if [[ -t 1 ]]; then
  C_RESET='\033[0m'
  C_BOLD='\033[1m'
  C_DIM='\033[2m'
  C_CYAN='\033[0;36m'
  C_YELLOW='\033[0;33m'
  C_GREEN='\033[0;32m'
  C_RED='\033[0;31m'
  C_WHITE='\033[0;37m'
  C_BRIGHT_WHITE='\033[1;37m'
  C_BRIGHT_CYAN='\033[1;36m'
  C_BRIGHT_YELLOW='\033[1;33m'
  C_BRIGHT_GREEN='\033[1;32m'
else
  C_RESET='' C_BOLD='' C_DIM='' C_CYAN='' C_YELLOW='' C_GREEN=''
  C_RED='' C_WHITE='' C_BRIGHT_WHITE='' C_BRIGHT_CYAN=''
  C_BRIGHT_YELLOW='' C_BRIGHT_GREEN=''
fi

# ─── Configurações padrão ────────────────────────────────────────────────────
ISO_NAME="${LIZ_ISO_NAME:-myliz}"
ISO_VERSION="${LIZ_ISO_VERSION:-1.0}"
ISO_ARCH="amd64"
ISO_LABEL="${ISO_NAME}-${ISO_VERSION}"
OUTPUT_DIR="${LIZ_OUTPUT_DIR:-/home/liz-output}"
WORK_DIR="${LIZ_WORK_DIR:-/home/liz-work}"
SQUASH_FILE="filesystem.squashfs"
CALAMARES_CONF_DIR="/etc/calamares"

# Compressão: zstd nível 22 — a mais eficiente disponível no mksquashfs
COMP_ALGO="zstd"
COMP_LEVEL=22

# Diretórios a excluir da ISO (não faz sentido incluir na live)
# /home e /root ficam fora — dados pessoais não vão na ISO
# O script grava em /home/liz-work, então /home DEVE ser excluído
EXCLUDE_DIRS=(
  # Sistemas virtuais — jamais incluir
  /proc /sys /dev /run

  # Temporários
  /tmp /var/tmp

  # Montagens externas
  /mnt /media

  # Dados pessoais (Limpos pelo overlayfs, mantemos as pastas originais vazias)
  # A exclusão física foi movida para o overlay para preservar os diretórios base
  
  # Cache de pacotes (ocupa muito, pode ser rebaixado)
  /var/cache/dnf
  /var/cache/apt
  /var/cache/yum
  /var/cache/pacman

  # Logs — não fazem sentido numa ISO live
  /var/log

  # Documentação — opcional, economiza espaço
  /usr/share/doc
  /usr/share/man
  /usr/share/info

  # Arquivos que não existem (Rocky)
  /lost+found /swapfile /swap.img

  # Diretórios de trabalho do próprio liz
  "${WORK_DIR}" "${OUTPUT_DIR}"
)

# ─── Arte ASCII ──────────────────────────────────────────────────────────────

print_banner() {
  echo -e "${C_BRIGHT_CYAN}"
  cat << 'EOF'
  ╔══════════════════════════════════════════════════════════════╗
  ║                                                              ║
  ║    ███╗   ███╗██╗██╗     ██╗███████╗                        ║
  ║    ████╗ ████║██║██║     ██║╚══███╔╝                        ║
  ║    ██╔████╔██║██║██║     ██║  ███╔╝                         ║
  ║    ██║╚██╔╝██║██║██║     ██║ ███╔╝                          ║
  ║    ██║ ╚═╝ ██║██║███████╗██║███████╗                        ║
  ║    ╚═╝     ╚═╝╚═╝╚══════╝╚═╝╚══════╝  ISO Builder v1.0.0   ║
  ║                                                              ║
  ╚══════════════════════════════════════════════════════════════╝
EOF
  echo -e "${C_RESET}"
}

