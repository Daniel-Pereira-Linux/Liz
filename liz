# ─── Comandos de Análise ─────────────────────────────────────────────────────

cmd_depends() {
  echo -e "${C_BRIGHT_WHITE}Análise de Dependências do LIZ${C_RESET}"
  echo "--------------------------------------------------------"
  
  local all_ok=true

  check_and_print() {
    local cmd="$1"
    local name="$2"
    local mandatory="$3"
    
    if check_dep "${cmd}"; then
      echo -e "[ ${C_BRIGHT_GREEN}OK${C_RESET} ] ${name} (${cmd}) está instalado."
    else
      if [[ "${mandatory}" == "true" ]]; then
        echo -e "[ ${C_RED}FALTA${C_RESET} ] ${name} (${cmd}) NÃO está instalado (Obrigatório)."
        all_ok=false
      else
        echo -e "[ ${C_YELLOW}AVISO${C_RESET} ] ${name} (${cmd}) NÃO está instalado (Recomendado)."
      fi
    fi
  }

  check_and_print "mksquashfs" "Squashfs-tools" "true"
  check_and_print "xorriso" "Xorriso" "true"
  
  # Grub check é especial pois o nome varia no Debian vs Rocky
  local grub_bin
  grub_bin="$(find_grub_mkrescue)"
  if [[ -n "${grub_bin}" ]]; then
    echo -e "[ ${C_BRIGHT_GREEN}OK${C_RESET} ] GRUB mkrescue (${grub_bin}) está instalado."
  else
    echo -e "[ ${C_RED}FALTA${C_RESET} ] GRUB mkrescue (grub-mkrescue / grub2-mkrescue) NÃO está instalado (Obrigatório)."
    all_ok=false
  fi

  check_and_print "calamares" "Calamares Installer" "true"

  echo "--------------------------------------------------------"
  if ${all_ok}; then
    echo -e "${C_BRIGHT_GREEN}✓ Todas as dependências obrigatórias estão instaladas no sistema.${C_RESET}"
  else
    echo -e "${C_YELLOW}⚠ Faltam dependências. Use 'sudo ./install.sh' ou instale manualmente antes de rodar o build.${C_RESET}"
  fi
  exit 0
}

# ─── Entry point ─────────────────────────────────────────────────────────────

case "${1:-}" in
  build)
    cmd_build
    ;;
  --depends)
    cmd_depends
    ;;
  --version|-v|version)
    echo "liz ${LIZ_VERSION}"
    ;;
  --help|-h|help|"")
    cmd_help
    ;;
  *)
    echo -e "${C_RED}✗ Comando desconhecido: ${1}${C_RESET}"
    echo -e "  Use ${C_BRIGHT_WHITE}liz --help${C_RESET} para ver os comandos disponíveis."
    exit 1
    ;;
esac
